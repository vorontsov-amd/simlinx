decode(24-31) {
    x01: BR
    x02: MOVLI
    x03: FLUSH
    x04: PUTPIXEL
    x05: B
    x06: MOVHI
    x07: ORI
    x08: INC_EQI
    x09: INC_NEI
    x0A: ADD 
    x0B: MUL 
    x0C: STORE
    x0D: LOAD
    x0E: BEQ
    x0F: BNE
    x10: BLE
    x11: BGT
    x12: BLEU
    x13: BGTU
    x14: SHL
    x15: SRA
    x16: SHR
    x17: XOR
    x18: SUB
    x19: CLEAR
}